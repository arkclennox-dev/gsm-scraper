# Delay between requests (seconds)
DELAY_MIN=2.0
DELAY_MAX=5.0

# Retry settings
MAX_RETRIES=5

# Default phone count when the web UI submits a brand/all scrape without a limit
DEFAULT_BRAND_LIMIT=50

# Logging
LOG_LEVEL=INFO

# Output paths
OUTPUT_DIR=data/output
CHECKPOINT_DIR=data/checkpoint

# GSMArena base URL
BASE_URL=https://www.gsmarena.com
